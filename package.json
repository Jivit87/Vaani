{
  "name": "vaani-voice-agent",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:tools": "tsx eval/run_tool_eval.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-nitro-voice": "^0.1.1",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
