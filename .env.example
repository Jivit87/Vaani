# Copy to .env (gitignored) and fill in. Values prefixed EXPO_PUBLIC_ are compiled into the app
# bundle and are readable by anyone with the APK: use a key you can revoke after grading.

# Provide at least one key. Provider is picked by EXPO_PUBLIC_LLM_PROVIDER, else NVIDIA if its key is set.
# NVIDIA: create at https://build.nvidia.com (Profile → API keys).
EXPO_PUBLIC_NVIDIA_API_KEY=nvapi-REPLACE_ME
# Groq free tier: create at https://console.groq.com/keys (rate-limited, no card needed).
# EXPO_PUBLIC_GROQ_API_KEY=gsk_REPLACE_ME
# 'nvidia' or 'groq'
# EXPO_PUBLIC_LLM_PROVIDER=groq

# Optional overrides; confirm model IDs in the catalog and pick by `npm run eval:tools`.
# EXPO_PUBLIC_LLM_PRIMARY=deepseek-ai/deepseek-v4.1-flash
# EXPO_PUBLIC_LLM_BACKUP=nvidia/nemotron-3.5-lightning-30b-a3b
# EXPO_PUBLIC_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional TTS tuning. Kokoro speaker ids: 31 hf_alpha (Hindi F), 32 hf_beta, 33 hm_omega, 34 hm_psi, 3 af_heart (English F).
# EXPO_PUBLIC_TTS_SPEAKER_ID=31
# EXPO_PUBLIC_TTS_SPEED=1.0
# 'kokoro' (default) or 'piper-hi' (fallback if Kokoro Hindi sounds wrong on your phone)
# EXPO_PUBLIC_TTS_ENGINE=kokoro

# Used only by `npm run eval:tools` (Node). If unset, the eval also reads EXPO_PUBLIC_NVIDIA_API_KEY from .env.
# NVIDIA_API_KEY=nvapi-REPLACE_ME
